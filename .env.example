# ============================================================
# YT Longform Studio — environment example
# Proyek ini KHUSUS video panjang (longform 16:9) dan upload YouTube saja.
# ============================================================

# Server / Dashboard lokal
PORT=3050
PUBLIC_BASE_URL=https://yt.emsa.pro
# PIN dashboard. WAJIB panjang & acak (>=12 karakter) — endpoint serverless rentan brute-force.
AUTO_DASHBOARD_PIN=
# Opsional: secret untuk token sesi cookie (HMAC). Jika kosong, diturunkan dari PIN
# (token otomatis invalid bila PIN diganti). Set nilai acak panjang untuk sesi mandiri.
DASHBOARD_SESSION_SECRET=

# OpenAI (naskah, gambar, TTS, transkripsi)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
STORY_MODEL=gpt-4.1-mini
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1536x1024
IMAGE_QUALITY=low
# Grid 2x2: 1 panggilan image = 4 visual berurutan per scene (on|off, default on)
IMAGE_GRID_MODE=on
# Kualitas khusus panggilan grid (default medium; lebih tinggi dari IMAGE_QUALITY karena 1 panggilan menggantikan beberapa)
IMAGE_GRID_QUALITY=medium
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar
OPENAI_TRANSCRIBE_MODEL=whisper-1

# DeepSeek (terjemahan metadata YouTube; key hanya di .env lokal/secret CI)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=60000

# Default TTS provider: openai | elevenlabs
YT_TTS_PROVIDER=openai

# ElevenLabs (opsional, alternatif TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=wUrGnU2Kx934kbDdOWDo
ELEVENLABS_SPEED=1.08

# Pexels (B-roll stock videos)
PEXELS_API_KEY=
PEXELS_PREFER_VIDEO=true
PEXELS_LOCALE=en-US
PEXELS_MIN_DURATION_SEC=8
PEXELS_MAX_RESULTS=30
PEXELS_MAX_QUERY_ATTEMPTS=2
# Seleksi scene berdasarkan kekonkretan visual (semantik).
PEXELS_SEMANTIC_SELECTION=true
# Porsi maksimum segmen visual yang diisi klip video (0-1, default 0.7 = 70%).
PEXELS_CLIP_RATIO=0.7
# DEPRECATED: relevansi kini murni ranking, bukan gerbang penolakan.
PEXELS_MIN_RELEVANCE=0.34
PEXELS_OVERLAY_ENABLED=true
PEXELS_OVERLAY_OPACITY=0.55
PEXELS_BLACK_KEY_SIMILARITY=0.16
PEXELS_BLACK_KEY_BLEND=0.08

# Wikimedia Commons media (GRATIS, tanpa API key).
# Mengisi slot kosong setelah Pexels dan sebelum gambar OpenAI.
WIKIMEDIA_MEDIA_ENABLED=true
WIKIMEDIA_MAX_ASSETS_PER_VIDEO=8
WIKIMEDIA_MAX_RESULTS=12
WIKIMEDIA_MAX_QUERY_ATTEMPTS=2
WIKIMEDIA_MIN_RELEVANCE=0.2
WIKIMEDIA_IMAGE_WIDTH=1920
WIKIMEDIA_MAX_IMAGE_MB=20
WIKIMEDIA_MAX_VIDEO_MB=120
# Aman secara default: Public Domain, CC0, CC BY. Aktifkan hanya bila siap
# memenuhi kewajiban ShareAlike pada karya turunan.
WIKIMEDIA_ALLOW_SHARE_ALIKE=false
# User-Agent deskriptif diwajibkan Wikimedia; isi kontak/repo yang valid.
WIKIMEDIA_USER_AGENT=yt-longform-studio/1.0 (+https://github.com/emsabiq-alt/yt-longform)
WIKIMEDIA_TIMEOUT_MS=15000
WIKIMEDIA_DOWNLOAD_TIMEOUT_MS=120000
WIKIMEDIA_REQUEST_DELAY_MS=150

# Render
SPEECH_TEMPO=1.0
RENDER_TITLE_FONT=Bebas Neue
RENDER_BODY_FONT=Noto Sans
RENDER_MONO_FONT=JetBrains Mono

# Otomatisasi longform
YT_TIME_ZONE=Asia/Bangkok
YT_DAILY_GENERATE_LIMIT=1
YT_DURATION_SEC=360
YT_SCENE_COUNT=14
YT_WORKFLOW_FILE=yt-longform-generate.yml
YT_STRICT_REMOTE=false
# Generate judul viral dari ringkasan deskripsi/summary menggunakan AI (true/false)
YT_VIRAL_TITLE_ENABLED=true
# Cold open: putar teaser hook (visual scene-1 + suara plan.hook) sebelum bumper/intro,
# dengan urutan pembuka yang diacak agar tidak selalu bumper/intro dulu (true/false)
YT_COLD_OPEN_ENABLED=true

# Wikipedia grounding (GRATIS, tanpa API key) — menyuntik fakta nyata ke naskah
# bila topik punya artikel; sumber otomatis dicantumkan di deskripsi (lisensi CC BY-SA).
WIKIPEDIA_GROUNDING_ENABLED=true
WIKIPEDIA_LANG=id
WIKIPEDIA_MAX_ARTICLES=2
WIKIPEDIA_MAX_CHARS=1800
# User-Agent wajib deskriptif (kebijakan Wikimedia). Ganti email/kontak yang valid.
# WIKIPEDIA_USER_AGENT=yt-longform-studio/1.0 (+https://yt.emsa.pro; kontak: admin@emsa.pro)
# WIKIPEDIA_TIMEOUT_MS=8000

# Cost estimator
STORY_INPUT_USD_PER_1M_TOKENS=0.40
STORY_OUTPUT_USD_PER_1M_TOKENS=1.60
OPENAI_TTS_USD_PER_1M_CHARS=15
ELEVENLABS_TTS_USD_PER_1K_CHARS=0.10

# YouTube auto upload (token sama persis dengan akun banyaktau)
YOUTUBE_UPLOAD_ENABLED=true
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=public
# Bahasa utama metadata video. Konten kanal tetap Bahasa Indonesia.
YOUTUBE_DEFAULT_LANGUAGE=id
# Judul/deskripsi otomatis setelah upload; tanpa key DeepSeek proses upload tetap berjalan.
YOUTUBE_LOCALIZATION_ENABLED=true
# Dipisahkan koma. Indonesia tidak perlu diulang karena menjadi bahasa utama.
YOUTUBE_LOCALIZATION_LANGUAGES=en,es,pt-BR,hi,bn,ar,fr,ja
YOUTUBE_CATEGORY_ID=27
YOUTUBE_TAGS=BanyakTau,Edukasi,Pengetahuan,Sains,Sejarah,Teknologi
# Thumbnail generation (false = skip AI thumbnail, buat manual)
THUMBNAIL_GENERATION_ENABLED=false

YOUTUBE_CUSTOM_THUMBNAIL_ENABLED=true
YOUTUBE_THUMBNAIL_UPLOAD_ATTEMPTS=1
YOUTUBE_DAILY_UPLOAD_LIMIT=2

# Auto-playlist: otomatis masukkan video ke playlist berdasarkan kategori
# Format: kategori:PLAYLIST_ID dipisah koma
# Contoh: sains:PLxxxxxxx,sejarah:PLyyyyyyy,teknologi:PLzzzzzzz
YOUTUBE_PLAYLISTS=
# Playlist default jika kategori tidak cocok (opsional)
YOUTUBE_DEFAULT_PLAYLIST_ID=

# YouTube Trending (data-driven topic selection)
# API key dari Google Cloud Console (YouTube Data API v3)
YOUTUBE_DATA_API_KEY=
YOUTUBE_TRENDING_ENABLED=true
YOUTUBE_TRENDING_REGION=ID

# Upload media ke hosting (folder TERPISAH dari banyaktau)
UPLOAD_DRIVER=sftp
SFTP_HOST=
SFTP_PORT=65002
SFTP_USER=
SFTP_PASSWORD=
SFTP_REMOTE_DIR=/home/USER/domains/emsa.pro/public_html/yt
SFTP_UPLOAD_TIMEOUT_SECONDS=300

FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_REMOTE_DIR=/public_html/yt
